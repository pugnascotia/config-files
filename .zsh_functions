#!/bin/bash

OS_TYPE=$(uname -s)

if [ "$OS_TYPE" = Darwin ]; then
    find() {
        if [[ "$*" == "" ]]; then
            /usr/bin/find .
        elif [[ "${1:0:1}" == "-" ]]; then
            /usr/bin/find . "$@"
        else
            /usr/bin/find "$@"
        fi
    }

    # Pruned ps
    pps() {
        # shellcheck disable=SC2009
        ps | grep -v iTerm | grep -v bash | cut -c-$COLUMNS
    }

    restart-dock() {
      PID=$(ps x | awk '/MacOS\/Dock$/ { print $1 }')
      if [[ -n "$PID" ]]; then
        kill "$PID"
      fi
    }
fi

__devctl() {
  if ! kubectl config get-contexts -o name | grep -qx "ecstaging-dev-awseuw1-mki-mgmt-unified-denv"; then
    echo "Missing kubectl context: ecstaging-dev-awseuw1-mki-mgmt-unified-denv"
    echo "Please log into the VPN, then run:"
    echo
    echo "  tsh login --proxy=teleport-proxy.staging.getin.cloud --auth=okta"
    echo "  tsh kube login dev-awseuw1-mki-mgmt-unified-denv"
    return 1
  fi

  /opt/homebrew/bin/devctl "$@"
}

# Only initialise nvm when used - use a function that replaces itself
nvm() {
  unset -f nvm
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use  # This loads nvm without resolving a node version
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
  nvm "$@" # now run it for real
}

# Load completions for kubectl on-demand
kubectl() {
    command kubectl "$@"
    local ret=$?
    if [[ -z $KUBECTL_COMPLETE ]]; then
        source <(command kubectl completion zsh)
        KUBECTL_COMPLETE=1
    fi
    return $ret
}
