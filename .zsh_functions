#!/bin/bash

OS_TYPE=$(uname -s)

if [ "$OS_TYPE" = Darwin ]; then
    find() {
        if [[ "$*" == "" ]]; then
            /usr/bin/find .
        elif [[ "${1:0:1}" == "-" ]]; then
            /usr/bin/find . "$@"
        else
            /usr/bin/find "$@"
        fi
    }

    # Pruned ps
    pps() {
        # shellcheck disable=SC2009
        ps | grep -v iTerm | grep -v bash | cut -c-$COLUMNS
    }

    restart-dock() {
      PID=$(ps x | awk '/MacOS\/Dock$/ { print $1 }')
      if [[ -n "$PID" ]]; then
        kill $PID
      fi
    }
fi

