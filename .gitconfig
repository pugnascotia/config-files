[user]
  name = Rory Hunter
  email = rory@elastic.co
  signingkey = FE315DC5B6F082FF
[color]
  ui = true
[alias]
  cleanup-branches = !git remote prune $( git remote | grep -E '(origin|upstream)' ) && echo && git branch -vvv | sed -e 's/^[*+ ]*//' | awk '/: gone]/ { print $1 }' | xargs -p git branch -D
  co = checkout
  edit = !vim $(git ls-files | grep "$@")
  exec = "!exec "
  evolution = log -p -M --follow --stat --
  ls = !git log --color --graph -n 30 --decorate --date=short --pretty='format:%Cblue%ad %Cgreen%h %<(20)%Cred%an %C(auto)%d %Creset%s' $@ | replace-emojis
  obliterate = push --no-verify --force-with-lease
  oops = commit --amend --no-edit
  push = !git push && git-show-pr-url
  root = !pwd
  tags = tag
  unstage = reset
  add-modified = !git status | awk '/^\t(both )*modified:/ { print $NF }' | xargs git add

  # Typos. Yes, yes, I know
  ad = add
  bracnh = branch
  bracnh = branch
  brnach = branch
  rbanch = branch
  comit = commit
  dif = diff
  grpe = grep
  pish = push
  piush = push
  puish = push
  shwo = show
[push]
  default = simple
  autoSetupRemote = true
[core]
  excludesfile = ~/.gitignore
  pager = less --tabs 4
[fetch]
  prune = true
[pull]
  ff = only
[init]
  defaultBranch = main
[url "git@github.com:"]
	insteadOf = https://github.com/
